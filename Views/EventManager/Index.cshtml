@model List<Assignment1.Models.Event>

@{
    ViewData["Title"] = "Event Manager";
}

<h1>Event Manager</h1>

<p>@ViewData["Message"]</p>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Location</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var ev in Model)
        {
            <tr>
                <td>@ev.Title</td>
                <td>@ev.Date.ToString("yyyy-MM-dd")</td>
                <td>@ev.Location</td>
                <td>
                    <a class="btn btn-primary"
                       asp-controller="EventManager"
                       asp-action="ManageAttendees"
                       asp-route-id="@ev.Id">
                        Manage Attendees
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
