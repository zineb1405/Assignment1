@model List<Assignment1.Models.Event>

@{
    ViewData["Title"] = "Event Manager";
}

<h1>Event Manager</h1>

@if (User.IsInRole("Organizer"))
{
    <p>
        <a class="btn btn-primary" asp-action="Create">Create New Event</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Date</th>
            <th>Location</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ev in Model)
        {
            <tr>
                <td>@ev.Title</td>
                <td>@ev.Date.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@ev.Location</td>
                <td>
                    <a asp-action="Details" asp-route-id="@ev.Id">Details</a>

                    @if (User.IsInRole("Organizer"))
                    {
                        <text> | </text>
                        <a asp-action="Edit" asp-route-id="@ev.Id">Edit</a>
                        <text> | </text>
                        <a asp-action="Delete" asp-route-id="@ev.Id">Delete</a>
                    }

                    <text> | </text>
                    <a asp-controller="Attendees" asp-action="Index" asp-route-eventId="@ev.Id">Attendees</a>
                </td>
            </tr>
        }
    </tbody>
</table>