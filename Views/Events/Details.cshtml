@model Assignment1.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<h1>@Model.Title</h1>

@if (!string.IsNullOrEmpty(Model.BannerUrl))
{
    <img src="@Model.BannerUrl" style="max-width:300px;" class="mb-3" />
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="mb-3">
    <strong>Description:</strong> @Model.Description
</div>

<div class="mb-3">
    <strong>Date:</strong> @Model.Date
</div>

<div class="mb-3">
    <strong>Location:</strong> @Model.Location
</div>

<hr />

<h3>Attendees (@Model.Attendees.Count)</h3>

@if (!Model.Attendees.Any())
{
    <p>No attendees yet.</p>
}
else
{
    <ul class="list-group mb-3">
        @foreach (var a in Model.Attendees)
        {
            <li class="list-group-item">
                <strong>@a.Name</strong> (@a.Email)
            </li>
        }
    </ul>
}

<!-- Organizer notification -->
@if (User.IsInRole("Organizer"))
{
    <div id="organizerNotification" class="alert alert-info mb-3" style="display:none;"></div>
}

<!-- Register / Unregister -->
@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isRegistered = Model.Attendees.Any(a => a.UserId == currentUserId);

    if (!isRegistered)
    {
        <form asp-action="Register" method="post" class="mb-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-success">Register</button>
        </form>
    }
    else
    {
        <form asp-action="Unregister" method="post" class="mb-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Unregister</button>
        </form>
    }
}

<!-- Organizer actions -->
@if (User.IsInRole("Organizer"))
{
    <a class="btn btn-primary"
       asp-controller="EventManager"
       asp-action="ManageAttendees"
       asp-route-id="@Model.Id">
        Manage Attendees
    </a>

    <a class="btn btn-warning"
       asp-action="Edit"
       asp-route-id="@Model.Id">
        Edit
    </a>

    <a class="btn btn-danger"
       asp-action="Delete"
       asp-route-id="@Model.Id">
        Delete
    </a>
}

<a class="btn btn-secondary" asp-action="Index">
    Back to Events
</a>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const isOrganizer = @User.IsInRole("Organizer").ToString().ToLower();

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/eventHub")
            .build();

        connection.start().then(function () {
            connection.invoke("JoinEventGroup", "event-@Model.Id");
        }).catch(function (err) {
            console.error(err.toString());
        });

        // Show private organizer notification
        connection.on("ReceiveOrganizerNotification", function (message) {
            const notificationDiv = document.getElementById("organizerNotification");
            if (notificationDiv) {
                notificationDiv.style.display = "block";
                notificationDiv.innerText = message;
            }
        });

        // Update attendees list
        connection.on("ReceiveAttendeeUpdate", function () {
            if (isOrganizer) {
                // Delay reload so organizer can see notification
                setTimeout(function () {
                    location.reload();
                }, 2000);
            } else {
                location.reload();
            }
        });
    </script>
}