@model List<Assignment1.Models.Attendee>

@{
    ViewData["Title"] = "Attendees";
}

<h1>Attendees for @ViewData["EventTitle"]</h1>

<p>
    <a class="btn btn-primary"
       asp-controller="Attendees"
       asp-action="Create"
       asp-route-eventId="@ViewData["EventId"]">
        Add Attendee
    </a>

    <a class="btn btn-secondary"
       asp-controller="Events"
       asp-action="Details"
       asp-route-id="@ViewData["EventId"]">
        Back to Event
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var attendee in Model)
        {
            <tr>
                <td>@attendee.Name</td>
                <td>@attendee.Email</td>
                <td>
                    <a asp-controller="Attendees"
                       asp-action="Edit"
                       asp-route-eventId="@ViewData["EventId"]"
                       asp-route-id="@attendee.Id">
                        Edit
                    </a> |
                    <a asp-controller="Attendees"
                       asp-action="Delete"
                       asp-route-eventId="@ViewData["EventId"]"
                       asp-route-id="@attendee.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>